"""
Crystal Quotation Automation — Windows Launcher

This is the entry point used by PyInstaller to build the .exe.
"""

import sys
import os
from pathlib import Path

def _setup_paths():
    """Set up sys.path for frozen and script modes."""
    if getattr(sys, "frozen", False):
        # Running as .exe
        base = Path(sys.executable).parent
    else:
        # Running as script
        base = Path(__file__).resolve().parent

    if str(base) not in sys.path:
        sys.path.insert(0, str(base))

    return base


def main():
    base = _setup_paths()
    print(f"Crystal Quotation Automation")
    print(f"Base directory: {base}")
    print()

    try:
        from ui.dashboard import Dashboard
    except Exception as exc:
        print("ERROR: Could not load dashboard.")
        print(f"{type(exc).__name__}: {exc}")
        import traceback
        traceback.print_exc()
        input("Press Enter to exit...")
        return

    # Create the ONE AND ONLY Tk root
    app = Dashboard()

    # Position window on-screen
    try:
        app.update_idletasks()
        sw = app.winfo_screenwidth()
        sh = app.winfo_screenheight()
        w = 1280
        h = 820
        x = max(0, (sw - w) // 2)
        y = max(0, (sh - h) // 2)
        app.geometry(f'{w}x{h}+{x}+{y}')
        app.deiconify()
        app.lift()
    except Exception as e:
        print(f'[window-fix] {e}')

    # Show setup wizard AFTER the dashboard exists (uses Toplevel, not new Tk)
    _ensure_first_run_setup(app)

    # Force the dashboard to the front again
    try:
        app.after(100, lambda: (app.lift(), app.focus_force()))
    except Exception:
        pass

    app.mainloop()




def _ensure_first_run_setup(parent=None):
    """Show the setup wizard if the app has never been configured.

    Uses the EXISTING Tk root (parent) — does NOT create a new one.
    """
    try:
        from app.services.setup_service import is_configured
        from ui.setup_wizard import run_wizard
    except Exception:
        return

    if is_configured():
        return

    # Pass the existing root as parent — no new tk.Tk()
    result = run_wizard(parent)
    if not result:
        # user cancelled — app will still run with default setup
        pass


if __name__ == "__main__":
    main()
