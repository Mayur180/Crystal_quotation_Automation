# ============================================================
# LOAD / SAVE
# ============================================================

def _ensure_dir():
    DATA_DIR.mkdir(parents=True, exist_ok=True)


def load_settings():
    """
    Return the merged dict of defaults + any saved overrides.
    Never raises — returns defaults on any error.
    """
    result = dict(DEFAULT_SETTINGS)

    try:
        if SETTINGS_FILE.is_file():
            with open(SETTINGS_FILE, "r", encoding="utf-8") as fh:
                saved = json.load(fh)
            if isinstance(saved, dict):
                for key, value in saved.items():
                    if value not in (None, ""):
                        result[key] = value
    except Exception:
        pass

    return result


def save_settings(settings):
    """
    Persist the given dict to data/company_settings.json.
    Returns (True, "") on success, (False, error_message) on failure.
    """
    if not isinstance(settings, dict):
        return False, "settings must be a dict"

    # Only keep known keys, to avoid accidentally storing junk
    cleaned = {}
    for key in DEFAULT_SETTINGS:
        if key in settings:
            cleaned[key] = settings[key]

    try:
        _ensure_dir()
        tmp = SETTINGS_FILE.with_suffix(".tmp")
        with open(tmp, "w", encoding="utf-8") as fh:
            json.dump(cleaned, fh, indent=2, ensure_ascii=False)
        os.replace(tmp, SETTINGS_FILE)
        return True, ""
    except Exception as exc:
        return False, f"{type(exc).__name__}: {exc}"


def reset_settings():
    """Delete the saved file — next load falls back to defaults."""
    try:
        if SETTINGS_FILE.is_file():
            SETTINGS_FILE.unlink()
        return True, ""
    except Exception as exc:
        return False, f"{type(exc).__name__}: {exc}"


def logo_full_path(settings=None):
    """Return the absolute path to the configured logo, or None."""
    if settings is None:
        settings = load_settings()

    rel = settings.get("logo_path") or ""
    if not rel:
        return None

    p = Path(rel)
    if not p.is_absolute():
        p = PROJECT_ROOT / p

    return p if p.is_file() else None


