"""
Crystal Quotation Automation — Windows Launcher

Single Tk root version — fixes the multi-root crash on some PCs.
"""

import sys
from pathlib import Path


def _setup_paths():
    """Set up sys.path for frozen and script modes."""
    if getattr(sys, "frozen", False):
        base = Path(sys.executable).parent
    else:
        base = Path(__file__).resolve().parent

    if str(base) not in sys.path:
        sys.path.insert(0, str(base))

    return base


def main():
    base = _setup_paths()

    try:
        from ui.dashboard import Dashboard
    except Exception as exc:
        import traceback
        traceback.print_exc()
        return

    # ---- Create the ONE AND ONLY Tk root ----
    app = Dashboard()
    app.withdraw()

    # Position window (before showing)
    try:
        app.update_idletasks()
        sw = app.winfo_screenwidth()
        sh = app.winfo_screenheight()
        w = 1280
        h = 820
        x = max(0, (sw - w) // 2)
        y = max(0, (sh - h) // 2)
        app.geometry(f"{w}x{h}+{x}+{y}")
    except Exception:
        pass

    # Show setup wizard as Toplevel on top of Dashboard
    _ensure_first_run_setup(app)

    # Show the dashboard
    try:
        app.deiconify()
        app.lift()
        app.attributes("-topmost", True)
        app.after(500, lambda: app.attributes("-topmost", False))
        app.focus_force()
    except Exception:
        pass

    app.mainloop()


def _ensure_first_run_setup(parent):
    """Show the setup wizard if the app has never been configured.

    Uses the existing Dashboard root. Does NOT create a new Tk.
    """
    try:
        from app.services.setup_service import is_configured
        from ui.setup_wizard import run_wizard
    except Exception:
        return

    if is_configured():
        return

    run_wizard(parent)


if __name__ == "__main__":
    main()
