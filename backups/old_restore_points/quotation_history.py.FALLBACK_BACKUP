        bg = "white"
        fg = self.RED if danger else self.TEXT
        active_bg = self.RED_LIGHT if danger else "#F3F4F6"

        return tk.Button(
            parent,
            text=text,
            command=command,
            bg=bg, fg=fg,
            activebackground=active_bg,
            activeforeground=fg,
            relief="solid", bd=1,
            highlightthickness=0,
            font=("Arial", 9, "bold"),
            cursor="hand2",
            padx=14, pady=6,
        )

