"""
CRYSTAL / ARMATECH ASSOCIATES
User tracking service.

Stores the current user's name in %APPDATA%/CRYSTAL/user.txt
so every action can be tagged with who did it.
"""

import os
from pathlib import Path


def _appdata_dir() -> Path:
    base = Path(os.environ.get("APPDATA", str(Path.home()))) / "CRYSTAL"
    base.mkdir(parents=True, exist_ok=True)
    return base


def _user_file() -> Path:
    return _appdata_dir() / "user.txt"


def get_current_user():
    """Return the saved username, or None if not set."""
    try:
        f = _user_file()
        if f.is_file():
            name = f.read_text(encoding="utf-8").strip()
            return name or None
    except Exception:
        pass
    return None


def set_current_user(name):
    """Save the username to disk."""
    try:
        name = (name or "").strip()
        if not name:
            return False
        _user_file().write_text(name, encoding="utf-8")
        return True
    except Exception:
        return False


def clear_current_user():
    """Remove the saved username."""
    try:
        f = _user_file()
        if f.is_file():
            f.unlink()
        return True
    except Exception:
        return False


def _admin_flag_file():
    """Location of the admin_pc.txt file.

    Reads from the shared data folder when set via CRYSTAL_DATA_DIR env var.
    Falls back to %APPDATA%/CRYSTAL/admin_pc.txt.
    """
    shared = os.environ.get("CRYSTAL_DATA_DIR")
    if shared:
        p = Path(shared)
        if p.is_dir():
            return p / "admin_pc.txt"
    return _appdata_dir() / "admin_pc.txt"


def is_admin():
    """True if this PC is the designated admin PC.

    Rule: admin_pc.txt contains the current PC's hostname → admin.
    If the file is missing, treat as single-PC → admin.
    """
    try:
        f = _admin_flag_file()
        if not f.is_file():
            return True
        configured = f.read_text(encoding="utf-8").strip()
        if not configured:
            return True
        import socket
        hostname = socket.gethostname()
        return configured.lower() == hostname.lower()
    except Exception:
        return True


def write_admin_pc(hostname=None):
    """Write this PC's hostname to admin_pc.txt (admin setup helper)."""
    import socket
    try:
        name = (hostname or socket.gethostname()).strip()
        _admin_flag_file().write_text(name, encoding="utf-8")
        return True
    except Exception:
        return False
