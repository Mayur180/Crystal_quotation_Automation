def _text(value: Any, default: str = "") -> str:
    if value is None:
        return default

    text = str(value).strip()

    return text if text else default


def _decimal(
    value: Any,
    default: Decimal = Decimal("0"),
) -> Decimal:
    """
    Convert any numeric-like value to Decimal.

    This is the main protection against:
        float + Decimal
        Decimal + float
    errors.
    """

    if value is None:
        return default

    if isinstance(value, Decimal):
        return value

    if isinstance(value, bool):
        return Decimal("1") if value else Decimal("0")

    try:
        text = str(value).strip()

        if not text:
            return default

        text = text.replace(",", "")
        text = text.replace("₹", "")
        text = text.strip()

        return Decimal(text)

    except (InvalidOperation, ValueError, TypeError):
        return default


def _number(
    value: Any,
    default: float = 0.0,
) -> float:
    """
    Compatibility helper for non-money values.
    """

    try:
        return float(_decimal(value))
    except Exception:
        return default


def _money(value: Any) -> str:
    amount = _decimal(value)

    return f"₹ {amount:,.2f}"


def _safe_filename(value: str) -> str:
    value = _text(value, "quotation")

    return re.sub(
        r"[^A-Za-z0-9._-]+",
        "_",
        value,
    )


def _money_for_words(value: Decimal) -> str:
    """
    Call the existing amount-in-words service safely.
    """

    try:
        return str(amount_in_words(float(value)))
    except Exception:
        return f"{value:,.2f} Rupees Only"


