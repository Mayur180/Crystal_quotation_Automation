def _resolve_product(model: str):
    if not get_product:
        return {}

    try:
        result = get_product(model)

        if isinstance(result, dict):
            return result

        return {}

    except Exception:
        return {}


def _get_spec(
    product,
    *keys,
    default="",
):
    if not isinstance(product, dict):
        return default

    for key in keys:
        value = product.get(key)

        if value not in (
            None,
            "",
        ):
            return value

    return default


def _split_items(value):
    if isinstance(value, list):
        return [
            str(item).strip()
            for item in value
            if str(item).strip()
        ]

    if not value:
        return []

    text = str(value)

    parts = re.split(
        r"\r?\n|•|;",
        text,
    )

    return [
        item.strip()
        for item in parts
        if item.strip()
    ]


