def _page1(
    doc,
    quotation_number,
    quotation_date,
    customer,
    model,
    product,
    machine_qty,
):
    """
    Page 1 — Cover page.

    Layout:
        1. Dynamic title from product_name (uppercase)
        2. Machine image (from catalog image_filename)
        3. Description paragraph (from catalog description)
        4. 9-row x 4-column table with offer/seller/buyer info
    """

    # --------------------------------------------------------
    # 1. Title
    # --------------------------------------------------------
    product_name = _get_spec(
        product,
        "product_name",
        "name",
        "product",
        default="Vision Measuring Machine",
    )
    _add_page_title(doc, str(product_name).upper())

    # --------------------------------------------------------
    # 2. Machine image
    # --------------------------------------------------------
    image_path = find_product_image(product)

    # --- Adaptive image size based on description length ---
    # Longer descriptions get smaller images so the whole page fits.
    description_text = _get_spec(product, "description", default="")
    desc_lines = [l.strip() for l in str(description_text).split("\n") if l.strip()]
    n_desc = len(desc_lines)

    if n_desc <= 2:
        img_mm = 95
    elif n_desc <= 4:
        img_mm = 80
    elif n_desc <= 6:
        img_mm = 65
    else:
        img_mm = 55

    if image_path:
        gap = doc.add_paragraph()
        gap.paragraph_format.space_after = Pt(0)
        gap.paragraph_format.space_before = Pt(0)

        p = doc.add_paragraph()
        p.alignment = WD_ALIGN_PARAGRAPH.CENTER
        p.paragraph_format.space_after = Pt(4)
        p.paragraph_format.space_before = Pt(0)
        p.add_run("\u200b")
        run = p.add_run()
        try:
            run.add_picture(str(image_path), width=Mm(img_mm))
        except Exception as e:
            print(f"[image-error] {type(e).__name__}: {e}")

    # --------------------------------------------------------
    # 3. Description
    # --------------------------------------------------------
    description = _get_spec(product, "description", default="")
    if description:
        for line in str(description).split("\n"):
            line = line.strip()
            if line:
                _add_body_with_bold(doc, line, size=9.5, after=1)

    spacer = doc.add_paragraph()
    spacer.paragraph_format.space_after = Pt(2)

    # --------------------------------------------------------
    # 4. Offer / Seller / Buyer table  (7 rows x 4 columns)
    # --------------------------------------------------------
    table = doc.add_table(rows=7, cols=4)
    table.alignment = WD_TABLE_ALIGNMENT.CENTER

    seller_name = COMPANY.get("name", "ARMATECH ASSOCIATES")
    seller_contact = "Mr. Amol Lunawat"
    seller_phone = "7020991684"
    seller_email = COMPANY.get("email", "armatech@gmail.com")
    seller_location = "Pune"

    buyer_company = _text(customer.get("company", ""), "-")
    buyer_name = _text(customer.get("name", ""), "-")
    buyer_phone = _text(customer.get("phone", ""), "-")
    buyer_email = _text(customer.get("email", ""), "-")
    buyer_city = _text(customer.get("city", ""), "")
    buyer_state_raw = _text(customer.get("state", ""), "")
    if buyer_city and buyer_state_raw:
        buyer_address = f"{buyer_city}, {buyer_state_raw}"
    elif buyer_city:
        buyer_address = buyer_city
    elif buyer_state_raw:
        buyer_address = buyer_state_raw
    else:
        buyer_address = "-"
    buyer_gstin = _text(customer.get("gstin", ""), "-")

    rows_data = [
        ("Offer No:", quotation_number, "Date:", quotation_date),
        ("Seller:", seller_name, "Company:", buyer_company),
        ("Contact:", seller_contact, "Buyer:", buyer_name),
        ("Phone:", seller_phone, "Phone:", buyer_phone),
        ("Email:", seller_email, "Email:", buyer_email),
        ("Location:", seller_location, "Address:", buyer_address),
        ("", "", "GSTIN:", buyer_gstin),
    ]

    for r_index, row in enumerate(rows_data):
        for c_index, value in enumerate(row):
            cell = table.cell(r_index, c_index)
